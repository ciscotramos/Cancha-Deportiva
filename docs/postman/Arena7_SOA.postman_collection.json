            "url": {
              "raw": "{{baseUrl}}/pagos/{{pagoId}}/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pagos",
                "{{pagoId}}",
                "confirmar"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoPago\": \"MANUAL-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.collectionVariables.get(\"baseUrl\") + \"/pagos\", method: \"GET\", header: {Accept: \"application/json\"}}, (e, res) => {",
                  "  const pago = res.json().find(p => Number(p.reserva_id) === Number(pm.collectionVariables.get(\"reservaId\")));",
                  "  pm.collectionVariables.set(\"pagoId\", pago.id);",
                  "});"
                ]
              }
            },
