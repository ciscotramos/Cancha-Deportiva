    {
      "name": "SRV-001 Autenticación",
      "item": [
        {
          "name": "Obtener CAPTCHA",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/captcha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "captcha"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200 y pregunta CAPTCHA\", () => { pm.response.to.have.status(200); pm.expect(r.pregunta).to.match(/\\d+ \\+ \\d+/); });",
                  "const m = r.pregunta.match(/(\\d+) \\+ (\\d+)/);",
                  "pm.collectionVariables.set(\"captcha\", String(Number(m[1]) + Number(m[2])));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"clave\": \"{{clave}}\",\n  \"captcha\": \"{{captcha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200: sesión abierta con rol\", () => { pm.response.to.have.status(200); pm.expect(r.user.rol).to.eql(\"administrador\"); });",
                  "pm.test(\"Devuelve token CSRF\", () => pm.expect(r.csrf).to.have.lengthOf(64));",
                  "pm.collectionVariables.set(\"csrf\", r.csrf);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesión",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200: sesión vigente\", () => { pm.response.to.have.status(200); pm.expect(r.user.correo).to.eql(pm.collectionVariables.get(\"correo\")); });"
                ]
              }
            }
          ]
        }
      ]
